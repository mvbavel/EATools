{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "eatools",
      "autoPort": true,
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec python3 -m uvicorn eatools.app:app --host 127.0.0.1 --port \"${PORT:-8100}\" --reload"
      ],
      "port": 8100
    }
  ]
}
